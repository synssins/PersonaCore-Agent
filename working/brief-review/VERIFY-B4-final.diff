+@pytest.mark.parametrize("method", UNEXPECTED_METHODS)
+async def test_an_anonymous_peer_cannot_tell_which_methods_are_accepted(method):
+    """405-before-401 would advertise the accepted methods to anyone asking."""
+    mw, app = make()
