+@pytest.mark.asyncio
+async def test_non_ascii_token_rejected_cleanly(mcp_server_port) -> None:
+    """A non-ASCII token is rejected with a clean -32000, not a crash.
+
+    ``secrets.compare_digest`` raises ``TypeError`` when given ``str``
+    operands that aren't pure ASCII. Pre-fix, ``_handle_initialize`` called
+    ``compare_digest`` on plain ``str`` values with no surrounding
+    try/except, so a client sending a non-ASCII token (an accented or CJK
+    character, say) would raise straight out of the JSON-RPC dispatch loop
+    and kill the connection instead of getting a normal "invalid token"
+    response — an unauthenticated, remotely triggerable crash once this
+    pipe's pattern is reused on B4's LAN endpoint. This asserts the client
+    gets back a clean JSON-RPC error, proving the connection didn't just
+    die.
+    """
+    port, _, _ = mcp_server_port
+    reader, writer = await _open_client(port)
+    resp = await _initialize(reader, writer, "café-你好-token")
+
+    assert "error" in resp
+    assert resp["error"]["code"] == -32000
+    writer.close()
+
+
+@pytest.mark.asyncio
+async def test_null_token_rejected(mcp_server_port) -> None:
+    """A JSON ``null`` token is rejected outright, not coerced to "None".
+
+    Pre-fix, ``str(params.get("token", ""))`` turned a missing/``None``
+    token into the literal string ``"None"`` before comparing it against
+    the real token — a type-confused rejection path rather than an
+    explicit one. This sends a literal JSON ``null`` and asserts it is
+    rejected the same way any other wrong token would be.
+    """
+    port, _, _ = mcp_server_port
+    reader, writer = await _open_client(port)
+
+    writer.write(_rpc("initialize", {"token": None, "protocolVersion": "2024-11-05"}, req_id=1))
+    await writer.drain()
+    resp = await _read_one(reader)
+
+    assert "error" in resp
+    assert resp["error"]["code"] == -32000
+    writer.close()
+
