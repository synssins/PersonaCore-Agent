+# ---------------------------------------------------------------------------
+# adb_push / adb_install — workstation paths
+# ---------------------------------------------------------------------------
+
+
+def test_push_of_a_missing_local_file_is_not_found_without_echoing_the_path(fake_adb):
+    result = adb.adb_push(
