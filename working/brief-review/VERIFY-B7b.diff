+# ---------------------------------------------------------------------------
+# §5.3 — binary never travels.  One test per tool that captures raw output.
+# ---------------------------------------------------------------------------
+
+_NOT_UTF8 = [0x89, 0x50, 0x4E, 0x47, 0xFF, 0xFE, 0x00, 0x80, 0x81]
