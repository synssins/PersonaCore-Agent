+def test_push_sends_the_local_path_and_the_device_path_in_that_order(fake_adb, tmp_path):
+    local = tmp_path / "note.txt"
+    local.write_text("hi", encoding="utf-8")
+    fake_adb.script([
+        fake_adb.devices(ONE_DEVICE),
