+# ---------------------------------------------------------------------------
+# adb_pull — text only in v1 (§10)
+# ---------------------------------------------------------------------------
+
+
+def test_pull_reads_a_text_file_through_exec_out_not_onto_the_disk(fake_adb):
+    """``adb pull`` would write the device's bytes onto this workstation before
