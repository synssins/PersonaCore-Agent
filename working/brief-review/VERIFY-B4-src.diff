+                "command": {"type": "string", "description": "The command to run on the device."},
+                "wait_s": _WAIT_S,
+            },
+            ["command"],
+        ),
+    ),
+    ServedTool(
+        name="adb_push",
+        internal_name="adb.push",
+        family="adb",
+        description=(
