+        self, root: Path, registry: sfj.JobRegistry,
+    ) -> None:
+        for i in range(sfj.MAX_JOBS):
+            _fake_job(registry, f"j-{i}", state="done")
+        out = _payload(sfj.dispatch("shell.run", {"command": "echo ok"}))
+        assert out["ok"] is True
